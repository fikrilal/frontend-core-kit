{
  "name": "lamara-frontend",
  "version": "0.1.0",
  "description": "Public web app for Lamara.",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm test:contracts && pnpm test:harness",
    "test:contracts": "node --test scripts/contracts/*.test.mjs",
    "test:harness": "node --test scripts/harness/*.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/testing/run-e2e.mjs",
    "contracts:sync": "node scripts/contracts/sync-openapi.mjs",
    "contracts:generate": "node scripts/contracts/generate-openapi.mjs",
    "contracts:check": "node scripts/contracts/check-openapi.mjs",
    "risk:classify": "node scripts/harness/classify-risk.mjs",
    "knowledge:check": "node scripts/harness/check-knowledge.mjs",
    "architecture:check": "node scripts/harness/check-architecture.mjs",
    "public-pages:check": "node scripts/harness/check-public-pages.mjs",
    "harness:check": "pnpm knowledge:check && pnpm architecture:check && pnpm public-pages:check",
    "verify:fast": "pnpm format:check && pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm harness:check",
    "verify": "pnpm format:check && pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm harness:check",
    "verify:runtime": "pnpm test:e2e",
    "commitlint": "commitlint",
    "setup:hooks": "node scripts/install-git-hooks.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.2.10",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "orval": "8.23.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
